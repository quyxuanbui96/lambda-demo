# Copy to `.env` and fill in. `.env` is git-ignored.
# Local API uses real AWS S3, like uretailV2; no deployment is needed.

# --- AWS ---------------------------------------------------------------
# AWS SSO profile used by `yarn aws:login` (configure with `aws configure sso`)
AWS_SSO_PROFILE=
AWS_REGION=ap-southeast-2

# --- CSV processing ----------------------------------------------------
# S3 bucket that receives CSV files (dev environment)
CSV_BUCKET_NAME=s3-sls-demo
# "true" if the bucket already exists and must NOT be created by `sls deploy`
CSV_BUCKET_EXISTING=true
# Only keys under this prefix trigger / are accepted. Must end with "/".
CSV_INPUT_PREFIX=input/
# One of: utf-8 | utf-8-sig | cp932 | shift_jis  (utf-8-sig accepts UTF-8 with or without BOM)
CSV_ENCODING=utf-8-sig
# Reject files larger than this (bytes). 10 MiB by default.
CSV_MAX_BYTES=10485760
# Max number of row errors returned/logged per file (1-1000)
CSV_MAX_REPORTED_ERRORS=100
# Presigned upload URL lifetime in seconds (60-3600)
PRESIGNED_URL_EXPIRES_SECONDS=900

LOG_LEVEL=DEBUG

# --- Acquisition / transfer workflow (separate service) ----------------
# Demo without real AWS/RDS: yarn workflow:local
# Fill these before yarn workflow:deploy. Never put DB passwords here.
WF_DEPLOYMENT_BUCKET=
WF_BUCKET=
WF_DATABASE_SECRET_ARN=
WF_DATABASE_SSL_ROOT_CERT=certs/global-bundle.pem
WF_VPC_SUBNET_IDS=
WF_VPC_SECURITY_GROUP_IDS=
WF_AUTH_MODE=bypass
WF_DEV_IDENTITY={"userId":"demo-user","allowedOrganizations":[{"organizationId":"org-demo","displayName":"Demo organization"}]}
WF_CONTRACTS_PATH=examples/workflow/contracts.demo.json
WF_URL_TTL_SECONDS=300
WF_MAX_FILE_BYTES=10485760
WF_TEMPORARY_RETENTION_SECONDS=86400
WF_POLL_INTERVAL_SECONDS=3
